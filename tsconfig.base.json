{
	"compilerOptions": {
		"target": "ESNext",
		"useDefineForClassFields": true,
		"module": "ESNext",
		"resolveJsonModule": true,
		"allowJs": true,
		"isolatedModules": true,
		"moduleDetection": "force",
		"noEmit": true,
		"skipLibCheck": true,
		"strict": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"noFallthroughCasesInSwitch": true,
		"moduleResolution": "bundler",
		"jsx": "preserve",
		"jsxImportSource": "solid-js",
		"paths": {
			"@dotaz/*": ["./src/*"],
			// Electrobun 2.x ships its SDK via the Hutch devkit, not node_modules.
			// Run `electrobun prepare` to (re)generate .hutch/devkit.
			"electrobun": ["./.hutch/devkit/api/sdks/main/index.ts"],
			"electrobun/bun": ["./.hutch/devkit/api/sdks/main/index.ts"],
			"electrobun/view": ["./.hutch/devkit/api/browser/index.ts"]
		}
	}
}
